#!/usr/bin/env bash
# =============================================================================
# config/bench.env — single source of truth for every knob in the pipeline.
# Sourced by lib/common.sh. Any value can be overridden from the environment:
#     SAMPLE_FREQ=499 ./script_raytrace.sh
# =============================================================================

# ---- Benchmark selection ----------------------------------------------------
PROJECT_BENCHES="${PROJECT_BENCHES:-raytrace nbody}"

# ---- Interpreters -----------------------------------------------------------
# CRITICAL — these are deliberately two different binaries:
#   PY_REL : release build. ALL timing / speedup numbers come from this.
#   PY_DBG : debug build (--with-pydebug). 2-4x SLOWER because it adds
#            assertions and reference-count tracing. Used ONLY for symbol-rich
#            perf sampling, never for timing.
# Mixing these up is the single most common way to publish a bogus speedup.
PY_REL="${PY_REL:-python3}"
PY_DBG="${PY_DBG:-python3-dbg}"

# ---- perf sampling ----------------------------------------------------------
# 999 not 1000: a non-round frequency avoids lock-stepping with periodic kernel
# timers and with the benchmark's own loop boundaries, which would bias samples
# toward whatever happens to run on the tick.
SAMPLE_FREQ="${SAMPLE_FREQ:-999}"

# Call-graph unwinding. This is an OVERHEAD knob:
#   fp    -> ~1-3% overhead. Needs frame pointers. FASTEST.
#   dwarf -> ~10-30% overhead + huge perf.data (copies stack per sample), but
#            works on stock CPython which is built -fomit-frame-pointer.
#   lbr   -> hardware; normally unavailable in a QEMU guest.
# Default dwarf for stack fidelity. Overhead is irrelevant here because the
# record pass's wall time is DISCARDED — see PHASE SEPARATION below.
CALLGRAPH="${CALLGRAPH:-dwarf}"
DWARF_STACK_BYTES="${DWARF_STACK_BYTES:-16384}"
PERF_MMAP_PAGES="${PERF_MMAP_PAGES:-32M}"   # big ring buffer => no lost samples

# =============================================================================
# PHASE SEPARATION — the core anti-overhead design of this repo
# =============================================================================
# Each measurement runs in its OWN process, in its own phase. No profiler is
# ever attached to a run whose timing we quote. Concretely:
#
#   PHASE 2  clean timing    PY_REL, no profiler, no perf  -> SPEEDUP NUMBERS
#   PHASE 3  perf stat       PY_REL + counters (~1% ovh)   -> IPC, cache, misses
#   PHASE 4  perf record     PY_DBG + sampling (high ovh)  -> flame graphs only
#   PHASE 5  cProfile        PY_REL + tracing (2-5x ovh)   -> call COUNTS only
#   PHASE 6  pyperformance   PY_REL, own harness           -> citable mean+stdev
#
# Rules enforced by lib/common.sh:
#   * perf stat and perf record NEVER wrap the same process.
#   * Timing from phases 4 and 5 is recorded but flagged DO-NOT-QUOTE.
#   * perf stat uses counting mode only (no -g, no sampling) => near-zero cost.
QUOTE_TIMING_FROM="${QUOTE_TIMING_FROM:-phase2_clean}"

# ---- Workload sizing --------------------------------------------------------
LOOPS="${LOOPS:-}"                 # empty => auto-calibrate to TARGET_SEC
TARGET_SEC="${TARGET_SEC:-3.0}"    # per-pass duration; >=3s gives ~3000 samples
CLEAN_REPS="${CLEAN_REPS:-7}"      # phase-2 repetitions -> median + stdev
REPS="${REPS:-5}"                  # perf stat -r repetitions

# ---- Noise control ----------------------------------------------------------
# Pin to one CPU so we do not measure the scheduler. CPU 0 keeps kernel timers.
PIN_CPU="${PIN_CPU:-1}"
USE_TASKSET="${USE_TASKSET:-1}"
# Fixed hash seed: str/dict hash randomization otherwise perturbs dict layout
# run-to-run, adding variance to exactly the paths these benchmarks stress.
PYTHONHASHSEED_VALUE="${PYTHONHASHSEED_VALUE:-0}"
# Cyclic GC fires on allocation counts; its pauses land inside the measured
# region. Both benchmarks are allocation-heavy (Vector objects), so we measure
# with GC disabled by default and report it explicitly in the manifest.
DISABLE_GC="${DISABLE_GC:-1}"

# ---- Phase toggles (turn any phase off to save time) ------------------------
ENABLE_VERIFY="${ENABLE_VERIFY:-1}"          # correctness gate, runs first
ENABLE_CLEAN_TIMING="${ENABLE_CLEAN_TIMING:-1}"
ENABLE_PERF_STAT="${ENABLE_PERF_STAT:-1}"
ENABLE_PERF_RECORD="${ENABLE_PERF_RECORD:-1}"
ENABLE_FLAMEGRAPH="${ENABLE_FLAMEGRAPH:-1}"
ENABLE_CPROFILE="${ENABLE_CPROFILE:-1}"
ENABLE_PYSPY="${ENABLE_PYSPY:-1}"
ENABLE_PYPERFORMANCE="${ENABLE_PYPERFORMANCE:-1}"
# Extra record pass keyed on cache-misses instead of time. Auto-skipped with
# no real PMU (i.e. QEMU without -cpu host).
ENABLE_CACHE_PROFILE="${ENABLE_CACHE_PROFILE:-1}"
# Topdown / CPI-stack style breakdown (lecture 3). Needs a real PMU.
ENABLE_TOPDOWN="${ENABLE_TOPDOWN:-1}"

# ---- Tooling locations ------------------------------------------------------
FLAMEGRAPH_DIR="${FLAMEGRAPH_DIR:-$HOME/FlameGraph}"
VENV_DIR="${VENV_DIR:-$HOME/.venvs/hwsw}"
RESULTS_DIR="${RESULTS_DIR:-$REPO_ROOT/results}"

# ---- perf event candidates (probed individually, unsupported ones dropped) ---
# perf stat aborts the ENTIRE run on one unsupported event, so we probe first.
PERF_EVENTS_SW="task-clock,page-faults,minor-faults,major-faults,context-switches,cpu-migrations"
PERF_EVENTS_HW="cycles,instructions,branches,branch-misses,cache-references,cache-misses"
PERF_EVENTS_MEM="L1-dcache-loads,L1-dcache-load-misses,LLC-loads,LLC-load-misses,dTLB-loads,dTLB-load-misses"
# FP events matter for raytrace/nbody specifically: they quantify how much of
# the work is actual arithmetic vs interpreter overhead, which is the core
# argument for the MAC/FMA accelerator proposal.
PERF_EVENTS_FP="fp_arith_inst_retired.scalar_double,fp_arith_inst_retired.128b_packed_double"
